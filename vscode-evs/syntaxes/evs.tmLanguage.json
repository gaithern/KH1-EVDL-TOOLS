{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KH1 EVS",
  "scopeName": "source.evs",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#block-header" },
    { "include": "#label" },
    { "include": "#keyword" },
    { "include": "#message" },
    { "include": "#member" },
    { "include": "#intrinsic" },
    { "include": "#call" },
    { "include": "#memory" },
    { "include": "#constant" },
    { "include": "#variable" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": { "name": "comment.line.double-slash.evs", "match": "//.*$" },
    "string": {
      "name": "string.quoted.double.evs",
      "begin": "\"", "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.evs", "match": "\\\\." },
        { "name": "constant.character.control.evs", "match": "\\{[^}\"]*\\}" }
      ]
    },
    "block-header": {
      "patterns": [
        { "match": "^\\s*(kgr)\\s+(\\d+)", "captures": { "1": { "name": "storage.type.kgr.evs" }, "2": { "name": "constant.numeric.evs" } } },
        { "match": "^\\s*(thread)\\s+(\\w+)", "captures": { "1": { "name": "storage.type.thread.evs" }, "2": { "name": "entity.name.type.thread.evs" } } },
        { "match": "^\\s*(globals|entities|names)\\s*(?=\\{)", "captures": { "1": { "name": "storage.type.declarations.evs" } } },
        { "match": "^\\s*(init|main|on_action|on_hit|on_talk|on_touch|on_lockon|entry_\\d+|[a-z_][a-z0-9_]*)\\s*(?=\\{\\s*$)", "captures": { "1": { "name": "entity.name.function.entry.evs" } } }
      ]
    },
    "label": { "match": "^\\s*(L\\d+)(:)", "captures": { "1": { "name": "entity.name.label.evs" } } },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.evs", "match": "\\b(if|else|while|goto|switch|case|default|break)\\b" },
        { "name": "keyword.other.task.evs", "match": "\\b(start|await)(?=\\s*\\()" },
        { "name": "keyword.other.evs", "match": "\\b(level|asm|raw)\\b" }
      ]
    },
    "message": {
      "match": "\\b(messages)(\\[)(0x[0-9A-Fa-f]+|\\d+)(\\])",
      "captures": { "1": { "name": "support.variable.messages.evs" }, "3": { "name": "constant.numeric.evs" } }
    },
    "member": {
      "match": "\\b([a-z_][a-z0-9_]*)(\\.)(init|main|on_\\w+|entry_\\d+|[a-z_][a-z0-9_]*)\\b",
      "captures": { "1": { "name": "entity.name.type.thread.evs" }, "3": { "name": "entity.name.function.entry.evs" } }
    },
    "intrinsic": { "name": "support.function.builtin.evs", "match": "\\b__\\w+(?=\\s*\\()" },
    "call": { "name": "support.function.syscall.evs", "match": "\\b(?:[A-Z][A-Za-z0-9]*_[A-Za-z0-9_]*|[A-Z][a-z][A-Za-z0-9]*|sys_\\d+)(?=\\s*\\()" },
    "memory": {
      "match": "\\b(save_data2?|runtime|bit)(\\.(?:byte|word|dword))?(?=\\[)",
      "captures": { "1": { "name": "variable.language.memory.evs" }, "2": { "name": "storage.modifier.width.evs" } }
    },
    "constant": {
      "patterns": [
        { "name": "constant.language.world.evs", "match": "\\bWORLD_[A-Z0-9_]+\\b" },
        { "name": "constant.other.gift.evs", "match": "\\bGIFT_[A-Z0-9_]+\\b" },
        { "name": "constant.other.item.evs", "match": "\\bITEM_[A-Z0-9_]+\\b" },
        { "match": "\\b([A-Z][A-Z0-9_]*)(\\.(?:word|dword))?\\b", "captures": { "1": { "name": "constant.other.evs" }, "2": { "name": "storage.modifier.width.evs" } } }
      ]
    },
    "variable": {
      "patterns": [
        { "name": "variable.other.local.evs", "match": "\\blocal\\d+\\b" },
        { "name": "entity.name.type.thread.evs", "match": "\\bthread_\\d+\\b" }
      ]
    },
    "number": { "name": "constant.numeric.evs", "match": "\\b(0x[0-9A-Fa-f]+|\\d+)\\b" },
    "operator": { "name": "keyword.operator.evs", "match": "==|!=|>=|<=|<<|[-+*/%<>&|^~!=]" }
  }
}
